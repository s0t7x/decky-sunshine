    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^30.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
